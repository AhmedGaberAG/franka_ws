#!/bin/bash
# Franka Panda Control Studio launcher

# Get the directory of this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Add the franka_gui_pkg package to PYTHONPATH
export PYTHONPATH="${SCRIPT_DIR}/franka_gui_pkg:${PYTHONPATH}"

# Run the GUI
exec python3 "${SCRIPT_DIR}/franka_gui_main.py" "$@"