<?xml version="1.0"?>
<sdf version="1.6">
  <model name="warehouse_agv">
    <link name="base_link">
      <inertial>
        <mass>25</mass>
        <inertia>
          <ixx>0.9375</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.875</iyy><iyz>0</iyz><izz>2.4375</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.90 0.60 0.30</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="chassis">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry><box><size>0.86 0.56 0.18</size></box></geometry>
        <material><ambient>0.08 0.22 0.45 1</ambient><diffuse>0.10 0.30 0.65 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
      </visual>
      <visual name="top_plate">
        <pose>0 0 0.17 0 0 0</pose>
        <geometry><box><size>0.70 0.50 0.04</size></box></geometry>
        <material><ambient>0.25 0.27 0.30 1</ambient><diffuse>0.40 0.42 0.45 1</diffuse></material>
      </visual>
      <visual name="cargo_tote">
        <pose>-0.05 0 0.30 0 0 0</pose>
        <geometry><box><size>0.34 0.30 0.22</size></box></geometry>
        <material><ambient>0.75 0.30 0.05 1</ambient><diffuse>0.95 0.45 0.10 1</diffuse></material>
      </visual>
      <visual name="wheel_front_left">
        <pose>0.30 0.29 -0.06 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="wheel_front_right">
        <pose>0.30 -0.29 -0.06 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="wheel_rear_left">
        <pose>-0.30 0.29 -0.06 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="wheel_rear_right">
        <pose>-0.30 -0.29 -0.06 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.04 0.04 0.04 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="sensor_mast">
        <pose>0.25 0 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.30</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
    </link>

    <plugin filename="ignition-gazebo-trajectory-follower-system"
            name="ignition::gazebo::systems::TrajectoryFollower">
      <link_name>base_link</link_name>
      <loop>true</loop>
      <force>165</force>
      <torque>300</torque>
      <range_tolerance>0.8</range_tolerance>
      <bearing_tolerance>10</bearing_tolerance>
      <zero_vel_on_bearing_reached>true</zero_vel_on_bearing_reached>
      <waypoints>
        <waypoint>-3.5 -2.0</waypoint>
        <waypoint>3.5 -2.0</waypoint>
        <waypoint>3.5 2.0</waypoint>
        <waypoint>-3.5 2.0</waypoint>
      </waypoints>
    </plugin>
  </model>
</sdf>
