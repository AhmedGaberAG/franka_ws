<?xml version="1.0"?>
<sdf version="1.6">
  <model name="cube_blue">
    <link name="link">
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000203</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000203</iyy><iyz>0</iyz><izz>0.000203</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.09 0.09 0.09</size></box></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.09 0.09 0.09</size></box></geometry>
        <material><ambient>0.06 0.20 0.80 1</ambient><diffuse>0.06 0.20 0.80 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
      </visual>
    </link>

      <plugin filename="ignition-gazebo-trajectory-follower-system"
              name="ignition::gazebo::systems::TrajectoryFollower">
        <link_name>link</link_name>
        <topic>/conveyor/pause</topic>
        <force>0.08</force>
        <torque>0.001</torque>
        <range_tolerance>0.03</range_tolerance>
        <zero_vel_on_bearing_reached>true</zero_vel_on_bearing_reached>
        <waypoints>
          <waypoint>0.70 0</waypoint>
        </waypoints>
      </plugin>
  </model>
</sdf>
