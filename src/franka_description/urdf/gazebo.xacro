<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Simulation plugins and per-link properties.
       is_ignition=true  -> Ignition / Gazebo Sim 6 (Humble)
       is_ignition=false -> gz / Gazebo Sim 7+ (Iron and newer) -->
  <xacro:macro name="panda_gazebo" params="prefix:='' is_sim:=true is_ignition:=true sensors:=false">

    <xacro:if value="${is_sim}">
      <gazebo>
        <xacro:if value="${is_ignition}">
          <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
            <parameters>$(find franka_controller)/config/controllers.yaml</parameters>
          </plugin>
        </xacro:if>
        <xacro:unless value="${is_ignition}">
          <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find franka_controller)/config/controllers.yaml</parameters>
          </plugin>
        </xacro:unless>

        <xacro:if value="${sensors}">
          <xacro:if value="${is_ignition}">
            <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
              <render_engine>ogre2</render_engine>
            </plugin>
          </xacro:if>
          <xacro:unless value="${is_ignition}">
            <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
              <render_engine>ogre2</render_engine>
            </plugin>
          </xacro:unless>
        </xacro:if>
      </gazebo>

      <!-- High friction and many contact points on the finger pads, so grasped
           objects stay in the gripper. -->
      <gazebo reference="${prefix}panda_leftfinger">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <maxContacts>10</maxContacts>
      </gazebo>
      <gazebo reference="${prefix}panda_rightfinger">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <maxContacts>10</maxContacts>
      </gazebo>

      <!-- Hand-mounted camera, published on a Gazebo topic. -->
      <xacro:if value="${sensors}">
        <gazebo reference="${prefix}panda_hand">
          <sensor name="panda_hand_camera" type="camera">
            <pose>0 0 0.05 0 0 0</pose>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <camera>
              <horizontal_fov>1.047</horizontal_fov>
              <image>
                <width>640</width>
                <height>480</height>
                <format>R8G8B8</format>
              </image>
              <clip>
                <near>0.02</near>
                <far>10</far>
              </clip>
            </camera>
          </sensor>
        </gazebo>

        <link name="${prefix}panda_hand_camera_optical_frame"/>
        <joint name="${prefix}panda_hand_camera_optical_joint" type="fixed">
          <origin rpy="${-pi/2} 0 ${-pi/2}" xyz="0 0 0.05"/>
          <parent link="${prefix}panda_hand"/>
          <child link="${prefix}panda_hand_camera_optical_frame"/>
        </joint>
      </xacro:if>
    </xacro:if>

  </xacro:macro>

</robot>
