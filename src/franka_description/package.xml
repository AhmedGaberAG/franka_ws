<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>franka_description</name>
  <version>0.1.0</version>
  <description>
    URDF/Xacro description of the Franka Emika Panda 7-DoF arm with the
    parallel-jaw hand. The description is split into four focused files:
    properties (tunable values), panda (links and joints), ros2_control
    (hardware interface) and gazebo (simulation tags).
  </description>
  <maintainer email="ahmedmgaber28@gmail.com">Ahmed Gaber</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
